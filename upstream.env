# Upstream versions this release line accepts, as semver ranges. Weekly
# rebuilds install the newest version inside each range, so a new upstream
# major never reaches users on its own.
#
# To adopt one, change the range in a PR and judge what it means for users:
# if it breaks existing setups, release a new major of this image.
CLOUDCLI_RANGE=^1
CLAUDE_CODE_RANGE=^2
FNM_RANGE=^1
# Any 0.x: uv's minor releases can change behaviour, but rarely in ways that
# affect this image's setup.
UV_RANGE=^0
