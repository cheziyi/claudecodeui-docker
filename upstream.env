# Upstream versions releases accept, as semver ranges. Daily
# patch releases install the newest version inside each range, so a new upstream
# major never reaches users on its own.
#
# To adopt one, widen the range in a PR and judge what it means for users:
# label the PR `major` if it breaks existing setups, `minor` otherwise.
CLOUDCLI_RANGE=^1
CLAUDE_CODE_RANGE=^2
FNM_RANGE=^1
# Any 0.x: uv's minor releases can change behaviour, but rarely in ways that
# affect this image's setup.
UV_RANGE=^0
