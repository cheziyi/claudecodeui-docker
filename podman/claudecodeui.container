# Podman Quadlet unit: the Podman equivalent of compose.yaml.
#
# Install (rootless):
#   mkdir -p ~/.config/containers/systemd ~/claudecodeui/workspaces
#   cp claudecodeui.container claudecodeui-home.volume ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start claudecodeui
#
# To keep it running after you log out: loginctl enable-linger "$USER"

[Unit]
Description=Claude Code UI (CloudCLI + Claude Code)
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/cheziyi/claudecodeui:1
ContainerName=claudecodeui
PublishPort=3001:3001

# Rootless Podman: map your host user to the container's "dev" user (1000)
# and run as it, so files in the workspace stay owned by you. PUID/PGID are
# not needed here.
UserNS=keep-id:uid=1000,gid=1000
User=1000:1000
# Lets dev use ping. Docker allows every group by default; Podman only root's.
# Under keep-id the range is checked against host gids, where dev's gid is
# yours, so it names dev's gid alone.
# Quoted: Quadlet splits values at spaces.
Sysctl="net.ipv4.ping_group_range=1000 1000"

# Your projects. The directory must exist. :z relabels it for SELinux
# (Fedora/RHEL) as shared, so other containers can mount the same folder;
# harmless elsewhere.
Volume=%h/claudecodeui/workspaces:/workspaces:z
# Claude Code login, settings and sessions, the UI's accounts database,
# git/gh/ssh config and shell history. Survives image updates.
Volume=claudecodeui-home.volume:/home/dev
# Docker: off by default. To enable it, add a drop-in from optional/ (see the
# README's Docker section): dind.conf for Docker inside this container, or
# podman-socket.conf for your own rootless Podman.

Environment=TZ=Etc/UTC
# Optional: commit identity for git inside the container.
#Environment=GIT_USER_NAME="Your Name"
#Environment=GIT_USER_EMAIL=you@example.com
# Optional: skip the interactive login. A Podman secret keeps the token out of
# this file and out of `podman inspect`. Store the token from
# `claude setup-token` (printf, so no trailing newline gets in):
#   read -rs t && printf %s "$t" | podman secret create claude_oauth - && unset t
#Secret=claude_oauth,type=env,target=CLAUDE_CODE_OAUTH_TOKEN
# Or an API key the same way, with target=ANTHROPIC_API_KEY.

# Podman ignores the image's HEALTHCHECK (CI publishes OCI-format images), so
# declare it here. The script follows SERVER_PORT inside the container.
HealthCmd=/usr/local/bin/cloudcli-healthcheck
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=3

# Lets `podman auto-update` (or podman-auto-update.timer) pull new builds.
AutoUpdate=registry

[Service]
Restart=always
# The first start pulls the image (about 1 GB); systemd's default 90s timeout
# can expire before it finishes.
TimeoutStartSec=900

[Install]
WantedBy=default.target
